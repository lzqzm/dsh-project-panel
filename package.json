{
  "name": "dsh-project-panel",
  "version": "0.1.18",
  "description": "DSH 工程面板：把低代码工程目录树搬进 web 端 —— 左栏常驻图标 + 中栏工程浏览器（多级文件树 / 推送状态 / 文件内容）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "工程面板",
    "summary": "把低代码工程目录搬进 DSH Web 侧栏：多级文件树、推送状态账本、源码编辑、推送前静态校验、工程脚本运行，以及空白目录一键开局。",
    "categories": [
      "开发工具",
      "Web UI",
      "低代码"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "compatibility": {
      "dsh": ">=0.2.0-0",
      "node": "^22.19.0 || >=24.0.0"
    },
    "permissions": {
      "filesystem": [
        "registered-workspaces"
      ]
    }
  },
  "//permissions": "dshhub.permissions 只是给 dshhub 市场看的声明，DSH 运行时不据它拦截（本地也没有可查的枚举定义）。如实补一句：本插件还会写 DSH_HOME 下的这几个文件，它们都不在工作区里 —— project-config.json（服务器档案，含密码明文）、project-push-state.json（推送账本）、project-env-backups/（写 .env 前的备份）、AGENTS.md（用户级全局开发规范，只由「安装」按钮显式触发，已存在就一个字节都不动）。",
  "files": [
    "lib",
    "src",
    "scaffold",
    "cordis.patch.yml",
    "README.md",
    "NOTES.md",
    "平台预览页登录说明.md"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client-plugin",
    "project-panel",
    "lowcode",
    "magicalcoder",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lzqzm/dsh-project-panel.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0"
  },
  "scripts": {
    "build:vendor": "node scripts/build-vendor.mjs",
    "release": "node scripts/publish-release.mjs",
    "build:editor": "esbuild src/editor.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=lib/client.editor.js",
    "watch:editor": "esbuild src/editor.js --bundle --format=iife --target=es2022 --minify --legal-comments=none --outfile=lib/client.editor.js --watch"
  },
  "//devDependencies": "archiver / axios / form-data / unzipper 不是 lib/index.js 自己 import 的，而是插件自带脚手架（scaffold/ 里的 source-*.js）要用的。**必须留在 devDependencies**：它们的传递依赖（unzipper → readable-stream@2 → string_decoder、archiver → readable-stream@3 → string_decoder）会被 DSH 的 generation peer validation 判成「解析到闭包外」，桌面端 / 市场直接装不上（2026-11-27 实测 generation-install: generation peer validation failed）。发布的包里不带 node_modules：改版本后跑一次 `npm run build:vendor`，把打好的 scaffold/vendor/deps.cjs 一起提交 —— 客户机器上没有 npm，全靠它兜底。",
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "archiver": "^6.0.0",
    "axios": "^1.6.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "form-data": "^4.0.6",
    "unzipper": "^0.10.0"
  }
}